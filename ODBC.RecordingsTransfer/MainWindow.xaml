<Window x:Class="ODBC.RecordingsTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ODBC.RecordingsTransfer.ViewModels"
        xmlns:models="clr-namespace:ODBC.RecordingsTransfer.Models"
        mc:Ignorable="d"
        Title="ODBC Recordings Transfer"
        Height="760" Width="1040"
        MinHeight="640" MinWidth="900"
        Background="#F5F5F5"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2B579A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:TransferActionViewModel}">
            <StackPanel Margin="0,6">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Width="18" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Complete}">
                                        <Setter Property="Text" Value="✓"/>
                                        <Setter Property="Foreground" Value="#2B7A2B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Skipped}">
                                        <Setter Property="Text" Value="–"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Failed}">
                                        <Setter Property="Text" Value="✗"/>
                                        <Setter Property="Foreground" Value="#B33A3A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Pending}">
                                        <Setter Property="Text" Value="○"/>
                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </DockPanel>
                <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress}" Margin="18,4,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.InProgress}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ODBC Recordings Transfer" FontSize="24" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,4"/>
            <TextBlock Text="Transfer MP4 recordings and clean up old MKV files" FontSize="14" Foreground="#666666"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Settings" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Source Path"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Width="340"/>
                    <Button Content="Browse..." Command="{Binding BrowseSourceCommand}" Background="#666666"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="Destination Path"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Width="340"/>
                    <Button Content="Browse..." Command="{Binding BrowseDestinationCommand}" Background="#666666"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Max File Age (days)"/>
                        <TextBox Text="{Binding MaxFileAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Min Free Space (GB)"/>
                        <TextBox Text="{Binding MinFreeSpaceGb, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Auto Close (sec, 0=off)"/>
                        <TextBox Text="{Binding AutoCloseSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                    <CheckBox Content="Verify Transfer (MD5)" IsChecked="{Binding VerifyTransfer}"/>
                    <CheckBox Content="Verify Remux (FFmpeg)" IsChecked="{Binding VerifyRemux}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Auto-start transfer on startup" IsChecked="{Binding AutoRunOnStartup}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="Start delay (sec)"/>
                        <TextBox Text="{Binding AutoRunDelayText, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                    <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckForUpdatesOnStartup}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="Update channel"/>
                        <ComboBox ItemsSource="{Binding UpdateChannels}"
                                  SelectedItem="{Binding UpdateChannelName}"
                                  Width="100" Margin="0,0,0,8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Background="#555555"/>
                    <Button Content="Run Transfer" Command="{Binding RunTransferCommand}" FontWeight="SemiBold" Padding="20,6"/>
                    <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" Background="#3A6EA5"/>
                    <Button Content="Open Log Folder" Command="{Binding OpenLogFolderCommand}" Background="#666666"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontStyle="Italic" Foreground="#666666" Cursor="Hand"
                               MouseLeftButtonDown="StatusText_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Detected: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DetectedCount}" Margin="0,0,24,0"/>
                <TextBlock Text="Moved: " FontWeight="SemiBold" Foreground="#2B7A2B"/>
                <TextBlock Text="{Binding MovedCount}" Foreground="#2B7A2B" Margin="0,0,24,0"/>
                <TextBlock Text="Deleted: " FontWeight="SemiBold" Foreground="#B33A3A"/>
                <TextBlock Text="{Binding DeletedCount}" Foreground="#B33A3A" Margin="0,0,24,0"/>
                <TextBlock Text="Left: " FontWeight="SemiBold" Foreground="#888888"/>
                <TextBlock Text="{Binding LeftCount}" Foreground="#888888"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Activity Log" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Background="#999999"
                                HorizontalAlignment="Right" DockPanel.Dock="Right" Padding="8,4" FontSize="12"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" Foreground="#333333"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Transfer Queue" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TransferItems}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#AAAAAA" DockPanel.Dock="Left"/>
            <TextBlock Text="Open Door Baptist Church - Media Ministry" FontSize="11"
                       Foreground="#AAAAAA" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,8,0,0"/>
        </DockPanel>
    </Grid>
</Window>
