<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>transfer_icon.ico</ApplicationIcon>
    <AssemblyName>ODBC Recordings Transfer</AssemblyName>
    <RootNamespace>ODBC.RecordingsTransfer</RootNamespace>
    <Version>2.2.7</Version>
    <AssemblyVersion>2.2.7.0</AssemblyVersion>
    <FileVersion>2.2.7.0</FileVersion>
    <InformationalVersion>2.2.7</InformationalVersion>
    <RepositoryUrl>https://github.com/chasemsutton/ODBC-Recordings-Transfer</RepositoryUrl>
    <Company>Open Door Baptist Church</Company>
    <Product>ODBC Recordings Transfer</Product>
    <Description>Transfer MP4 recordings and clean up old MKV files</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="transfer_icon.ico" />
  </ItemGroup>

</Project>
