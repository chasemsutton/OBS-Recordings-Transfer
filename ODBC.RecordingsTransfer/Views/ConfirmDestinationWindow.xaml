<Window x:Class="ODBC.RecordingsTransfer.Views.ConfirmDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Destination"
        Height="260" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Destination folder year mismatch"
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>

        <CheckBox Grid.Row="2" x:Name="DontAskAgainCheckBox"
                  Content="Don't ask me again" Margin="0,12,0,12" FontSize="13"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="10,6" IsCancel="True" Click="CancelButton_Click"/>
            <Button Content="Continue" Width="90" Padding="10,6" FontWeight="SemiBold" IsDefault="True" Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
