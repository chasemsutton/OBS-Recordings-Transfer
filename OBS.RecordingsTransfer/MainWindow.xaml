<Window x:Class="OBS.RecordingsTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OBS.RecordingsTransfer.ViewModels"
        xmlns:models="clr-namespace:OBS.RecordingsTransfer.Models"
        mc:Ignorable="d"
        Title="OBS Recordings Transfer"
        Height="760" Width="1040"
        MinHeight="400" MinWidth="360"
        Background="#F5F5F5"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#2B579A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:TransferActionViewModel}">
            <StackPanel Margin="0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Complete}">
                                        <Setter Property="Text" Value="✓"/>
                                        <Setter Property="Foreground" Value="#2B7A2B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Skipped}">
                                        <Setter Property="Text" Value="–"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Failed}">
                                        <Setter Property="Text" Value="✗"/>
                                        <Setter Property="Foreground" Value="#B33A3A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Pending}">
                                        <Setter Property="Text" Value="○"/>
                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActionType}" Value="{x:Static models:TransferActionType.WaitingRemux}"/>
                                            <Condition Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.Pending}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="…"/>
                                        <Setter Property="Foreground" Value="#C47D00"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActionType}" Value="{x:Static models:TransferActionType.WaitingRemux}"/>
                                            <Condition Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.InProgress}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="…"/>
                                        <Setter Property="Foreground" Value="#C47D00"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontFamily="Consolas" FontSize="11"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="18,4,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TransferActionStatus.InProgress}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                 IsIndeterminate="False">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="#2B579A"/>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <TextBlock Text="{Binding ProgressText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#333333"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainBodyRow" Height="*" MinHeight="280"/>
            <RowDefinition x:Name="ActivityLogRow" Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CompactColumn" Width="*" MinWidth="0"/>
                <ColumnDefinition x:Name="SettingsColumn" Width="1.4*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  MinWidth="0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="172"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="OBS Recordings Transfer"
                           FontSize="22" FontWeight="SemiBold" Foreground="#1A1A1A"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="8,8" Margin="0,0,0,8"
                        BorderBrush="#E0E0E0" BorderThickness="1" MinWidth="0"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <RadioButton Content="Manual start" GroupName="TransferMode"
                                         IsChecked="{Binding IsTransferModeNone}"
                                         Margin="0,0,18,0" Padding="0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Transfers run only when you click Run Transfer. Nothing starts automatically."/>
                            <RadioButton Content="Auto-start" GroupName="TransferMode"
                                         IsChecked="{Binding IsTransferModeAutoStart}"
                                         Margin="0,0,18,0" Padding="0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="After launch, wait for the Auto-start delay in Settings, then run one transfer and stop."/>
                            <RadioButton Content="Continuous" GroupName="TransferMode"
                                         IsChecked="{Binding IsTransferModeContinuous}"
                                         Margin="0" Padding="0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="After launch (and the Auto-start delay), keep watching for remux-ready MP4s and transfer them as they appear. Use Stop Transfer to return to Manual start."/>
                        </StackPanel>

                        <!-- Button row stays fixed; countdown/status live below so Cancel never shifts. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding TransferPrimaryCommand}"
                                    FontWeight="SemiBold" Padding="0" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" Width="128" Height="34" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2B579A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoStartCountdownActive}" Value="True">
                                                <Setter Property="Background" Value="#B33A3A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAutoCloseCountdownActive}" Value="True">
                                                <Setter Property="Background" Value="#E6A817"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowStopTransferButton}" Value="True">
                                                <Setter Property="Background" Value="#B33A3A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="10,4">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Run Transfer" FontWeight="SemiBold" Foreground="White" Margin="0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutoStartCountdownActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAutoCloseCountdownActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowStopTransferButton}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Cancel" FontWeight="SemiBold" Foreground="White" Margin="0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAutoStartCountdownActive, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAutoCloseCountdownActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Cancel" FontWeight="SemiBold" FontSize="13" Foreground="#1A1A1A"
                                                       TextAlignment="Center" Margin="0" LineHeight="14"/>
                                            <TextBlock Text="(keep open)" FontSize="10" Foreground="#1A1A1A"
                                                       TextAlignment="Center" Margin="0" LineHeight="12"/>
                                        </StackPanel>
                                        <TextBlock Text="Stop Transfer" FontWeight="SemiBold" Foreground="White" Margin="0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowStopTransferButton, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Button Content="{Binding SettingsToggleButtonText}" Command="{Binding ToggleSettingsPanelCommand}" Background="#555555"
                                    VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsAutoStartCountdownActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AutoStartCountdownText}" FontSize="12" Foreground="#666666" Margin="0,0,0,4"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding AutoStartCountdownProgress}"
                                         HorizontalAlignment="Center" Width="200"/>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}"
                                   HorizontalAlignment="Stretch"
                                   FontStyle="Italic" Foreground="#666666" Margin="0,4,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoStartCountdownActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,0,0,8" MinWidth="0">
                    <TextBlock DockPanel.Dock="Left" Text="Destination"
                               FontSize="11" Foreground="#888888" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DestinationPath}"
                               FontSize="11" Foreground="#555555"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DestinationPath}"/>
                </DockPanel>

                <Border x:Name="TransferQueuePanel" Grid.Row="3" Background="White" CornerRadius="8" Padding="10"
                        BorderBrush="#E0E0E0" BorderThickness="1" MinWidth="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Transfer Queue" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6"/>
                        <!-- MinHeight ~4 single-line items; grows with the window -->
                        <ListBox Grid.Row="1" MinHeight="120"
                                 ItemsSource="{Binding TransferItems}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 HorizontalContentAlignment="Stretch"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="12,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1" MinWidth="0"
                    Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MinWidth="0">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="Transfer MP4 recordings and clean up old MKV files"
                                       FontSize="13" Foreground="#666666" Margin="0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Source Path"
                                   ToolTip="Folder where OBS writes remuxed MP4 (and MKV) recordings."/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8"
                                   ToolTip="Folder where OBS writes remuxed MP4 (and MKV) recordings.">
                            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseSourceCommand}"
                                    Background="#666666" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                        </DockPanel>

                        <TextBlock Text="Destination Path"
                                   ToolTip="Folder where finished MP4 files are moved."/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8"
                                   ToolTip="Folder where finished MP4 files are moved.">
                            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseDestinationCommand}"
                                    Background="#666666" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                        </DockPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Margin="0,0,16,8"
                                        ToolTip="Delete old MKV files older than this many days (when a matching MP4 exists).">
                                <TextBlock Text="Max File Age (days)"/>
                                <TextBox Text="{Binding MaxFileAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8"
                                        ToolTip="If free space on the source drive is below this, older MKVs may be deleted sooner to free space.">
                                <TextBlock Text="Min Free Space (GB)"/>
                                <TextBox Text="{Binding MinFreeSpaceGb, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8"
                                        ToolTip="Seconds to wait after a successful transfer before closing the app. Use 0 to leave it open.">
                                <TextBlock Text="Auto Close (sec, 0=off)"/>
                                <TextBox Text="{Binding AutoCloseSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8"
                                        ToolTip="Seconds to wait after launch before the first transfer in Auto-start or Continuous mode.">
                                <TextBlock Text="Auto-start delay (sec)"/>
                                <TextBox Text="{Binding AutoRunDelayText, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="Continuous mode" FontWeight="SemiBold" Margin="0,0,0,4"
                                       ToolTip="Optional launch behavior when using Continuous transfer mode."/>
                            <CheckBox Content="Start with Windows"
                                      IsChecked="{Binding StartWithWindows}"
                                      Margin="0,0,0,4"
                                      ToolTip="Launch the app when you sign in to Windows. Pair with Continuous mode to keep transferring in the background."/>
                            <CheckBox Content="Start minimized"
                                      IsChecked="{Binding StartMinimized}"
                                      Margin="0,0,0,4"
                                      ToolTip="Open the window minimized (useful when starting with Windows)."/>
                        </StackPanel>

                        <CheckBox Content="I do not record directly in MP4 (skips extra checks)"
                                  IsChecked="{Binding AssumeNoDirectMp4Recording}"
                                  Margin="0,8,0,0"
                                  ToolTip="Unchecked (safer default): after the remux index (moov) appears, wait ~20 more seconds of stable size so a live direct-to-MP4 recording is less likely to be copied during a brief size pause. Checked (typical OBS remux to MP4): transfer as soon as moov appears on a non-growing file."/>

                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="Check for updates on startup"
                                      IsChecked="{Binding CheckForUpdatesOnStartup}"
                                      VerticalAlignment="Center"
                                      ToolTip="Look for a newer app version each time the program starts."/>
                            <StackPanel Margin="0,0,16,0"
                                        ToolTip="Stable installs release builds; Beta can install or roll back among compatible beta builds.">
                                <TextBlock Text="Update channel"/>
                                <ComboBox ItemsSource="{Binding UpdateChannels}"
                                          SelectedItem="{Binding UpdateChannelName}"
                                          Width="100" Margin="0,0,0,8"/>
                            </StackPanel>
                            <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}"
                                    Background="#3A6EA5" VerticalAlignment="Center" Margin="0,0,0,8"
                                    ToolTip="Check GitHub now for an update on the selected channel."/>
                        </WrapPanel>

                        <Expander Header="Advanced" IsExpanded="False" Margin="0,8,0,0"
                                  ToolTip="Less-common options. Expand only if you need them.">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox Content="Wait for remux to finish before moving MP4s (off = high risk of file corruption)"
                                          IsChecked="{Binding CheckRemuxComplete}"
                                          Margin="0,0,0,8"
                                          ToolTip="Detects when an MP4 is finished (stable file size + moov atom). Leave on whenever recordings may still be writing. Turning this off can copy a partial/corrupt file."/>
                                <CheckBox Content="Don't warn when destination folder year doesn't match current year"
                                          IsChecked="{Binding SkipDestinationYearWarning}"
                                          Margin="0,0,0,8"
                                          ToolTip="When checked, the year mismatch prompt is skipped. Uncheck to show the warning again."/>
                                <Button Content="Open Log Folder"
                                        Command="{Binding OpenLogFolderCommand}"
                                        Background="#666666"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"
                                        ToolTip="Open the folder containing activity and error logs."/>

                                <TextBlock Text="Unsupported / untested" FontWeight="SemiBold"
                                           Foreground="#666666" Margin="0,4,0,6"
                                           ToolTip="These checks are slower and not part of the normal workflow."/>
                                <CheckBox Content="Verify Transfer (MD5)"
                                          IsChecked="{Binding VerifyTransfer}"
                                          Margin="0,0,0,4"
                                          ToolTip="After copying, compare MD5 hashes of source and destination. Slower; not normally needed."/>
                                <CheckBox Content="Verify Remux (FFmpeg)"
                                          IsChecked="{Binding VerifyRemux}"
                                          Margin="0,0,0,0"
                                          ToolTip="Full FFmpeg decode check at transfer time (much slower). Separate from the lightweight remux wait above."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1"
                Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Activity Log" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" Background="#999999"
                            HorizontalAlignment="Right" DockPanel.Dock="Right" Padding="8,4" FontSize="12" Margin="0"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Detected: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DetectedCount}" Margin="0,0,24,0"/>
                    <TextBlock Text="Moved: " FontWeight="SemiBold" Foreground="#2B7A2B"/>
                    <TextBlock Text="{Binding MovedCount}" Foreground="#2B7A2B" Margin="0,0,24,0"/>
                    <TextBlock Text="Deleted: " FontWeight="SemiBold" Foreground="#B33A3A"/>
                    <TextBlock Text="{Binding DeletedCount}" Foreground="#B33A3A" Margin="0,0,24,0"/>
                    <TextBlock Text="Left: " FontWeight="SemiBold" Foreground="#888888"/>
                    <TextBlock Text="{Binding LeftCount}" Foreground="#888888"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="12" Foreground="#333333" Margin="0"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2"
                   Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#AAAAAA" DockPanel.Dock="Left"/>
        </DockPanel>
    </Grid>
</Window>
